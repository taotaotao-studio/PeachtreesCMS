# PeachtreesCMS - Apache Environment Configuration & Security Rules
#
# NOTE: these rules used to live ENTIRELY inside <IfModule mod_rewrite.c>, so a
# host without mod_rewrite silently lost every protection at once. Directory
# listing and dotfile blocking are now unguarded (they need no module), and the
# runtime-dir block has both a mod_alias and a mod_rewrite form.

# 1. Prevent directory listing / indexes leakage
Options -Indexes

# 2. Block direct access to sensitive config & metadata files
<FilesMatch "^\.(env|installed|gitignore|git)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 3. Block runtime data directories.
#    pt_api/sessions/ holds PHP session files whose contents include a PLAINTEXT
#    captcha answer, and the file name is the session id — serving one of these
#    as a static file defeats the captcha entirely. rate_limits/ (removed
#    2026-09-17) used to hold per-IP login attempt records. Neither is ever a
#    legitimate HTTP target.
#
#    Guarded by <IfModule> because an unknown directive in .htaccess makes Apache
#    return 500 for the ENTIRE site. The mod_rewrite fallback below covers hosts
#    that lack mod_alias.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/.*/?pt_api/(sessions|rate_limits)/
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Belt-and-braces: same two runtime dirs, plus the dotfiles, via mod_rewrite.
  RewriteRule ^pt_api/(sessions|rate_limits)/ - [F,L]
  RewriteRule ^pt_api/\.(env|installed)$ - [F,L]
</IfModule>
