# PeachtreesCMS Nginx 配置示例 — 后端分离部署（高级配置）
#
# 这是【同一个产品】的一种高级部署拓扑，不是独立版本：代码与 release.zip
# 与合体部署完全一致，差别只在 PHP 放到 web root 之外、由 .env 指回前端目录。
#
# 部署结构：
#   /var/www/html/blog/            ← 前端 + content/ 用户内容目录（nginx root 下）
#     ├── index.html
#     ├── admin.html
#     ├── assets/
#     ├── content/
#     │   ├── uploads/             ← PHP 需要跨目录写入上传目录
#     │   ├── themes/              ← PHP 需要跨目录扫描主题目录
#     │   └── patterns/            ← PHP 需要跨目录扫描风格目录
#     └── languages/
#
#   /var/www/php/pt_api/           ← PHP 后端（在 web root 之外）
#
# ⚠️ 此方案需在 pt_api/.env 中配置一个 CONTENT_DIR（PHP 代码即可全部归位）：
#
#   CONTENT_DIR=/var/www/html/blog/content
#
# （也可以按子目录单独覆盖：UPLOAD_DIR / THEME_DIR / STYLE_DIR，见
#   pt_api/.env.example。）
#
# 并确保 php-fpm 的 open_basedir 允许 PHP 读写 /var/www/html/blog/content/。
#
# 前端构建配置（与同目录方案一致）：
#   vite.config.js → base: '/blog/'
#   pt_frontend/.env → VITE_API_BASE_URL=/blog/pt_api/

server {
    listen 80;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;
    server_name your-domain.com;

    # 拒绝访问所有以点 (.) 开头的隐藏敏感文件或目录（如 .env, .installed, .git）
    location ~ /\\. {
        deny all;
        return 404;
        log_not_found off;
        access_log off;
    }

    # 拒绝访问运行时数据目录。
    # 注意：下面的 dotfile 规则匹配不到 pt_api/sessions/ —— 它没有前导点，
    # 且不以 .php 结尾（因此也不会命中下面的 PHP location），最终会落到静态
    # 文件分支被原样吐出。会话文件里存着【明文验证码答案】，文件名就是 session id，
    # 一旦可读则验证码形同虚设。必须显式拒绝（.htaccess 与 nginx 都要有）。
    # （容器部署时 SESSION_DIR 已移出 web root，无此风险。）
    location ~ ^/blog/pt_api/(sessions|rate_limits)(/|$) {
        deny all;
        return 404;
        log_not_found off;
        access_log off;
    }

    # PHP 处理 — PHP 文件在 web root 之外，通过绝对路径指定
    location ~ ^/blog/pt_api/(.+\.php)$ {
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        index index.php;
        # Windows 使用 TCP:
        # fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME /var/www/php/pt_api/$1;
        include fastcgi_params;
    }

    # 前端静态资源 + content/ 用户内容目录
    location /blog/ {
        try_files $uri $uri/ =404;

        # 安全响应头
        add_header X-Content-Type-Options nosniff;
        add_header X-Frame-Options DENY;
        add_header X-XSS-Protection "1; mode=block";
    }
}
